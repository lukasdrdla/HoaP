@page "/booking/payment/{ReservationId:int}"
@layout BookingLayout
@rendermode InteractiveServer

@inject ReservationService ReservationService
@inject CurrencyService CurrencyService
@inject IPaymentGatewayService PaymentGateway
@inject NavigationManager NavigationManager

<PageTitle>Online platba</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-6">
        @if (errorMessage != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle me-1"></i> @errorMessage
            </div>
        }
        else if (isInitiating)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <h5>Pripravujeme platbu...</h5>
                <p class="text-muted">Budete presmerovani na platebni branu.</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int ReservationId { get; set; }

    private string? errorMessage;
    private bool isInitiating = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var reservation = await ReservationService.GetReservationByIdAsync(ReservationId);
            if (reservation == null)
            {
                errorMessage = "Rezervace nebyla nalezena.";
                isInitiating = false;
                return;
            }

            var returnUrl = $"/booking/payment-result/{ReservationId}";
            var description = $"Platba za rezervaci #{ReservationId} - pokoj {reservation.RoomNumber}";
            var currencyCode = reservation.CurrencySymbol ?? "CZK";

            var session = await PaymentGateway.InitiatePaymentAsync(
                reservation.TotalPrice,
                currencyCode,
                returnUrl,
                description);

            NavigationManager.NavigateTo(session.PaymentUrl);
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba pri inicializaci platby: {ex.Message}";
            isInitiating = false;
        }
    }
}
