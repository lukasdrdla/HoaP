@using HoaP.Application.ViewModels.RatePlan
@inject RatePlanService RatePlanService

<h5>Cenové plány</h5>

<QuickGrid Items="ratePlans.AsQueryable()" Pagination="pagination" Class="table table-bordered mt-3 w-100">
    <PropertyColumn Title="Název" Property="@(x => x.Name)" />
    <PropertyColumn Title="Typ pokoje" Property="@(x => x.RoomTypeName ?? "Všechny")" />
    <PropertyColumn Title="Pokoj" Property="@(x => x.RoomNumber ?? "Všechny")" />
    <PropertyColumn Title="Od" Property="@(x => x.StartDate.ToString("dd.MM.yyyy"))" />
    <PropertyColumn Title="Do" Property="@(x => x.EndDate.ToString("dd.MM.yyyy"))" />
    <TemplateColumn Title="Modifikátor">
        @if (context.IsPercentage)
        {
            <span class="@(context.PriceModifier >= 0 ? "text-danger" : "text-success")">
                @(context.PriceModifier >= 0 ? "+" : "")@context.PriceModifier.ToString("0.##") %
            </span>
        }
        else
        {
            <span class="@(context.PriceModifier >= 0 ? "text-danger" : "text-success")">
                @(context.PriceModifier >= 0 ? "+" : "")@context.PriceModifier.ToString("0.##") Kč
            </span>
        }
    </TemplateColumn>
    <TemplateColumn Title="Aktivní">
        <span class="badge @(context.IsActive ? "bg-success" : "bg-secondary")">
            @(context.IsActive ? "Ano" : "Ne")
        </span>
    </TemplateColumn>
    <PropertyColumn Title="Priorita" Property="@(x => x.Priority)" />
    <TemplateColumn Title="Akce">
        <button class="btn btn-sm btn-primary" @onclick="() => EditRatePlan(context)">
            <i class="bi bi-pencil"></i>
        </button>
        <button class="btn btn-sm btn-danger" @onclick="() => DeleteRatePlan(context.Id)">
            <i class="bi bi-trash"></i>
        </button>
    </TemplateColumn>
</QuickGrid>

<Paginator State="pagination" />

<hr />

<h6>@(isEdit ? "Upravit cenový plán" : "Nový cenový plán")</h6>

<EditForm Model="currentRatePlan" OnValidSubmit="SaveRatePlan">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Název</label>
            <InputText class="form-control" @bind-Value="currentRatePlan.Name" />
            <ValidationMessage For="@(() => currentRatePlan.Name)" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Priorita</label>
            <InputNumber class="form-control" @bind-Value="currentRatePlan.Priority" />
        </div>
        <div class="col-md-3">
            <div class="form-check mt-4">
                <InputCheckbox class="form-check-input" @bind-Value="currentRatePlan.IsActive" />
                <label class="form-check-label">Aktivní</label>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-md-3">
            <label class="form-label">Datum od</label>
            <InputDate class="form-control" @bind-Value="currentRatePlan.StartDate" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Datum do</label>
            <InputDate class="form-control" @bind-Value="currentRatePlan.EndDate" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Modifikátor ceny</label>
            <InputNumber class="form-control" @bind-Value="currentRatePlan.PriceModifier" />
        </div>
        <div class="col-md-3">
            <div class="form-check mt-4">
                <InputCheckbox class="form-check-input" @bind-Value="currentRatePlan.IsPercentage" />
                <label class="form-check-label">Procenta (%)</label>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-md-3">
            <label class="form-label">Min. nocí</label>
            <InputNumber class="form-control" @bind-Value="currentRatePlan.MinNights" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Max. nocí</label>
            <InputNumber class="form-control" @bind-Value="currentRatePlan.MaxNights" />
        </div>
    </div>

    <div class="mt-3">
        <label class="form-label">Platné dny v týdnu:</label>
        <div class="d-flex flex-wrap gap-3">
            <div class="form-check">
                <InputCheckbox class="form-check-input" @bind-Value="currentRatePlan.Monday" />
                <label class="form-check-label">Po</label>
            </div>
            <div class="form-check">
                <InputCheckbox class="form-check-input" @bind-Value="currentRatePlan.Tuesday" />
                <label class="form-check-label">Út</label>
            </div>
            <div class="form-check">
                <InputCheckbox class="form-check-input" @bind-Value="currentRatePlan.Wednesday" />
                <label class="form-check-label">St</label>
            </div>
            <div class="form-check">
                <InputCheckbox class="form-check-input" @bind-Value="currentRatePlan.Thursday" />
                <label class="form-check-label">Čt</label>
            </div>
            <div class="form-check">
                <InputCheckbox class="form-check-input" @bind-Value="currentRatePlan.Friday" />
                <label class="form-check-label">Pá</label>
            </div>
            <div class="form-check">
                <InputCheckbox class="form-check-input" @bind-Value="currentRatePlan.Saturday" />
                <label class="form-check-label">So</label>
            </div>
            <div class="form-check">
                <InputCheckbox class="form-check-input" @bind-Value="currentRatePlan.Sunday" />
                <label class="form-check-label">Ne</label>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button class="btn btn-success" type="submit">Uložit</button>
        @if (isEdit)
        {
            <button class="btn btn-secondary ms-2" type="button" @onclick="CancelEdit">Zrušit</button>
        }
    </div>
</EditForm>

@code {
    private List<RatePlanViewModel> ratePlans = new();
    private RatePlanFormViewModel currentRatePlan = new();
    private PaginationState pagination = new() { ItemsPerPage = 10 };
    private bool isEdit = false;

    protected override async Task OnInitializedAsync()
    {
        ratePlans = await RatePlanService.GetRatePlansAsync();
    }

    private async void EditRatePlan(RatePlanViewModel vm)
    {
        var detail = await RatePlanService.GetRatePlanByIdAsync(vm.Id);
        if (detail != null)
        {
            currentRatePlan = detail;
            isEdit = true;
            StateHasChanged();
        }
    }

    private async Task DeleteRatePlan(int id)
    {
        await RatePlanService.DeleteRatePlanAsync(id);
        ratePlans = await RatePlanService.GetRatePlansAsync();
    }

    private async Task SaveRatePlan()
    {
        if (isEdit)
            await RatePlanService.UpdateRatePlanAsync(currentRatePlan);
        else
            await RatePlanService.CreateRatePlanAsync(currentRatePlan);

        currentRatePlan = new RatePlanFormViewModel();
        ratePlans = await RatePlanService.GetRatePlansAsync();
        isEdit = false;
    }

    private void CancelEdit()
    {
        currentRatePlan = new RatePlanFormViewModel();
        isEdit = false;
    }
}
