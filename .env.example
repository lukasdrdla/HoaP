# HoaP - Docker Configuration
# Copy this file to .env and adjust values as needed
# Usage: cp .env.example .env

# PostgreSQL
POSTGRES_DB=hoapdb
POSTGRES_USER=hoap
POSTGRES_PASSWORD=HoaPSecure2025!

# Admin account (admin@admin.com)
ADMIN_PASSWORD=Admin123456789!

# Encryption key (must be exactly 32 characters)
ENCRYPTION_KEY=HoaPDockerEncryptKey2025SecureOK
